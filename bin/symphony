#!/usr/bin/env bash
# Start, stop and watch the symphony-copilot orchestrator.
set -euo pipefail

STATE_DIR="${SYMPHONY_STATE_DIR:-$HOME/symphony-workspaces}"
PID_FILE="$STATE_DIR/orchestrator.pid"
LOG_FILE="$STATE_DIR/logs/orchestrator.log"
LAST_FILE="$STATE_DIR/.last-workflow"

# Follow symlinks so the script also works when linked onto PATH.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  [[ "$target" = /* ]] && self="$target" || self="$(dirname "$self")/$target"
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"
CLI="$ROOT/src/cli.ts"

usage() {
  cat <<EOF
Usage: symphony <command> [path/to/WORKFLOW.md]

  run             run in this terminal; Ctrl-C stops it
  start           run in the background; keeps running after the terminal closes
  stop            stop the background run (agents stop, workspaces are kept)
  status          is it running, and what did it do last
  logs            follow the log

Setting up a repository (see docs/onboarding.md):
  install-skills  install the symphony-onboard and symphony-write-card skills into ~/.copilot/skills
  check           validate WORKFLOW.md; add --online to compare it with the board
  setup-board     create the board WORKFLOW.md describes and write its number into it

run and start default to the workflow used last time, then ./WORKFLOW.md;
check and setup-board default to ./WORKFLOW.md.
The GitHub token comes from SYMPHONY_GITHUB_TOKEN, or else 'gh auth token'.
Log: $LOG_FILE
EOF
}

running_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -q "src/cli.ts"; then
    echo "$pid"
    return 0
  fi
  rm -f "$PID_FILE"
  return 1
}

other_instances() {
  local pid
  for pid in $(pgrep -f 'src/cli\.ts' || true); do
    ps -p "$pid" -o command= | grep -q -- '--dry-run' || echo "$pid"
  done
}

pick_workflow() {
  local wf="${1:-${SYMPHONY_WORKFLOW:-}}"
  if [[ -z "$wf" && -f "$LAST_FILE" ]]; then wf="$(cat "$LAST_FILE")"; fi
  wf="${wf:-./WORKFLOW.md}"
  if [[ ! -f "$wf" ]]; then
    echo "No workflow at $wf. Pass it once: symphony $COMMAND path/to/WORKFLOW.md" >&2
    return 1
  fi
  wf="$(cd "$(dirname "$wf")" && pwd)/$(basename "$wf")"
  mkdir -p "$STATE_DIR"
  echo "$wf" > "$LAST_FILE"
  echo "$wf"
}

load_token() {
  if [[ -z "${SYMPHONY_GITHUB_TOKEN:-}" ]]; then
    SYMPHONY_GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
  fi
  if [[ -z "$SYMPHONY_GITHUB_TOKEN" ]]; then
    echo "No GitHub token: run 'gh auth login', or set SYMPHONY_GITHUB_TOKEN." >&2
    exit 1
  fi
  export SYMPHONY_GITHUB_TOKEN
}

refuse_if_running() {
  local pid others
  if pid="$(running_pid)"; then
    echo "Already running (pid $pid). Run 'symphony stop' first." >&2
    exit 1
  fi
  others="$(other_instances)"
  if [[ -n "$others" ]]; then
    # Two orchestrators would claim the same cards.
    echo "Another orchestrator is running (pid $(echo $others)). Stop it first: kill -TERM $(echo $others)" >&2
    exit 1
  fi
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  run)
    wf="$(pick_workflow "${1:-}")"
    load_token
    refuse_if_running
    echo "$$" > "$PID_FILE"
    cd "$ROOT"
    exec node "$CLI" "$wf"
    ;;
  start)
    wf="$(pick_workflow "${1:-}")"
    load_token
    refuse_if_running
    mkdir -p "$(dirname "$LOG_FILE")"
    cd "$ROOT"
    nohup node "$CLI" "$wf" >> "$LOG_FILE" 2>&1 < /dev/null &
    pid=$!
    echo "$pid" > "$PID_FILE"
    if command -v caffeinate > /dev/null; then
      nohup caffeinate -i -w "$pid" > /dev/null 2>&1 &
    fi
    sleep 3
    if kill -0 "$pid" 2>/dev/null; then
      echo "Started in the background (pid $pid) with $wf"
      echo "Follow it with: symphony logs"
    else
      echo "It exited right away. Last log lines:" >&2
      tail -n 15 "$LOG_FILE" >&2
      exit 1
    fi
    ;;
  stop)
    if ! pid="$(running_pid)"; then
      echo "Not running."
      exit 0
    fi
    kill -TERM "$pid"
    printf "Stopping (pid %s)" "$pid"
    for _ in $(seq 1 60); do
      if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PID_FILE"
        echo " stopped."
        exit 0
      fi
      printf "."
      sleep 1
    done
    echo
    echo "Still stopping after 60 s. Check 'symphony logs', or force it with: kill -9 $pid" >&2
    exit 1
    ;;
  status)
    if pid="$(running_pid)"; then
      echo "Running (pid $pid, up $(ps -p "$pid" -o etime= | tr -d ' ')) with $(cat "$LAST_FILE" 2>/dev/null || echo 'unknown workflow')"
    else
      echo "Not running."
    fi
    if [[ -f "$LOG_FILE" ]]; then
      last_tick="$(grep 'msg=tick' "$LOG_FILE" | tail -n 1 | sed -E 's/^ts=([^ ]+) .*msg=tick (.*)$/\1  \2/')"
      [[ -n "$last_tick" ]] && echo "Last poll: $last_tick"
      echo "Latest events:"
      grep -E 'msg=(dispatching|"session summary"|"issue halted"|"submitted for review"|"review submitted"|"follow-up issue created"|"run closed")|level=(warn|error)' "$LOG_FILE" \
        | grep -v "permission denied" | tail -n 6 | cut -c1-200
    fi
    ;;
  logs)
    if [[ ! -f "$LOG_FILE" ]]; then
      echo "No log yet: $LOG_FILE"
      exit 0
    fi
    tail -n 30 -f "$LOG_FILE" | grep --line-buffered -v "permission approved"
    ;;
  check|setup-board)
    wf="./WORKFLOW.md"
    if [[ -n "${1:-}" && "$1" != --* ]]; then wf="$1"; shift; fi
    if [[ ! -f "$wf" ]]; then
      echo "No workflow at $wf. Pass it: symphony $COMMAND path/to/WORKFLOW.md" >&2
      exit 1
    fi
    wf="$(cd "$(dirname "$wf")" && pwd)/$(basename "$wf")"
    if [[ "$COMMAND" == setup-board || " $* " == *" --online "* ]]; then load_token; fi
    exec node "$ROOT/src/tools.ts" "$COMMAND" "$wf" ${@+"$@"}
    ;;
  install-skills)
    dest="${COPILOT_SKILLS_DIR:-$HOME/.copilot/skills}"
    root_escaped="$(printf '%s' "$ROOT" | sed 's/[&|\\]/\\&/g')"
    for dir in "$ROOT"/skills/*/; do
      name="$(basename "$dir")"
      target="$dest/$name/SKILL.md"
      if [[ -f "$target" ]] && ! grep -q "Installed by symphony-copilot" "$target"; then
        echo "Skipped $name: $target exists and was not installed by symphony-copilot." >&2
        continue
      fi
      mkdir -p "$dest/$name"
      # The skills refer to templates and commands by absolute path.
      sed 's|\$SYMPHONY_HOME|'"$root_escaped"'|g' "$dir/SKILL.md" > "$target"
      echo "Installed $name in $dest/$name"
    done
    echo "VS Code and Copilot CLI pick them up from there. Rerun this after updating symphony-copilot."
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
