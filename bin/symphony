#!/usr/bin/env bash
# Start, stop and watch the symphony-copilot orchestrator.
set -euo pipefail

# Follow symlinks so the script also works when linked onto PATH.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  [[ "$target" = /* ]] && self="$target" || self="$(dirname "$self")/$target"
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"

usage() {
  cat <<EOF
Usage: symphony <command> [path/to/WORKFLOW.md | ID] [--id ID]

  run             run in this terminal; Ctrl-C stops it
  start           run in the background; keeps running after the terminal closes
  stop [ID]       stop one runner (agents stop, workspaces are kept)
  status [ID]     one runner's status/events, or list all runners
  logs [ID]       follow one log; --no-follow prints and exits
  list            list registered workflow IDs and their state

Setting up a repository (see docs/onboarding.md):
  install-skills  install the symphony-onboard and symphony-write-card skills into ~/.copilot/skills
  check           validate WORKFLOW.md; add --online to compare it with the board
  setup-board     create the board WORKFLOW.md describes and write its number into it

run and start accept --id ID; otherwise the ID is derived from the workflow path.
With one registered workflow, run/start/stop/logs need no ID. With several,
select a workflow path or ID explicitly. First run defaults to ./WORKFLOW.md;
check and setup-board default to ./WORKFLOW.md.
The GitHub token comes from SYMPHONY_GITHUB_TOKEN, or else 'gh auth token'.
Logs: \${SYMPHONY_STATE_DIR:-~/symphony-workspaces}/runners/<ID>/orchestrator.log
EOF
}

load_token() {
  if [[ -z "${SYMPHONY_GITHUB_TOKEN:-}" ]]; then
    SYMPHONY_GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
  fi
  if [[ -z "$SYMPHONY_GITHUB_TOKEN" ]]; then
    echo "No GitHub token: run 'gh auth login', or set SYMPHONY_GITHUB_TOKEN." >&2
    exit 1
  fi
  export SYMPHONY_GITHUB_TOKEN
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  run|start|stop|status|logs|list)
    if [[ "$COMMAND" == run || "$COMMAND" == start ]]; then load_token; fi
    exec node "$ROOT/src/manage.ts" "$COMMAND" ${@+"$@"}
    ;;
  check|setup-board)
    wf="./WORKFLOW.md"
    if [[ -n "${1:-}" && "$1" != --* ]]; then wf="$1"; shift; fi
    if [[ ! -f "$wf" ]]; then
      echo "No workflow at $wf. Pass it: symphony $COMMAND path/to/WORKFLOW.md" >&2
      exit 1
    fi
    wf="$(cd "$(dirname "$wf")" && pwd)/$(basename "$wf")"
    if [[ "$COMMAND" == setup-board || " $* " == *" --online "* ]]; then load_token; fi
    exec node "$ROOT/src/tools.ts" "$COMMAND" "$wf" ${@+"$@"}
    ;;
  install-skills)
    dest="${COPILOT_SKILLS_DIR:-$HOME/.copilot/skills}"
    root_escaped="$(printf '%s' "$ROOT" | sed 's/[&|\\]/\\&/g')"
    for dir in "$ROOT"/skills/*/; do
      name="$(basename "$dir")"
      target="$dest/$name/SKILL.md"
      if [[ -f "$target" ]] && ! grep -q "Installed by symphony-copilot" "$target"; then
        echo "Skipped $name: $target exists and was not installed by symphony-copilot." >&2
        continue
      fi
      mkdir -p "$dest/$name"
      # The skills refer to templates and commands by absolute path.
      sed 's|\$SYMPHONY_HOME|'"$root_escaped"'|g' "$dir/SKILL.md" > "$target"
      echo "Installed $name in $dest/$name"
    done
    echo "VS Code and Copilot CLI pick them up from there. Rerun this after updating symphony-copilot."
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
